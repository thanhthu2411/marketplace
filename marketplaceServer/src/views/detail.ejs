<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= listing.title %> — Campus Marketplace</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 640px; margin: 2rem auto; padding: 0 1rem; }
    .back-link { display: inline-block; margin-bottom: 1.2rem; color: #1e6b34; text-decoration: none; font-size: 0.9rem; }
    .back-link:hover { text-decoration: underline; }

    .detail-thumb {
      height: 220px;
      border-radius: 10px;
      background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 4rem;
      font-weight: 700;
      color: #1e6b34;
      margin-bottom: 1.2rem;
    }

    .detail-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 0.4rem;
    }

    .detail-price { font-size: 1.6rem; font-weight: 700; color: #1e6b34; }

    .tag {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      background: #f0f0f0;
      color: #666;
      padding: 0.25rem 0.6rem;
      border-radius: 999px;
    }

    h1 { margin: 0.2rem 0 0.6rem; font-size: 1.5rem; }

    .meta-row {
      display: flex;
      gap: 0.5rem;
      color: #777;
      font-size: 0.85rem;
      margin-bottom: 1.2rem;
    }

    .detail-description {
      line-height: 1.5;
      color: #333;
      margin-bottom: 1.5rem;
    }

    .info-box {
      background: #f9f9f9;
      border: 1px solid #eee;
      border-radius: 8px;
      padding: 0.9rem 1rem;
      margin-bottom: 1.5rem;
      font-size: 0.9rem;
    }

    .info-box strong { display: block; margin-bottom: 0.2rem; color: #555; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.03em; }

    .delete-btn {
      font-size: 0.85rem;
      color: #c0392b;
      background: none;
      border: 1px solid #f0c9c4;
      padding: 0.5rem 1rem;
      border-radius: 6px;
      cursor: pointer;
    }
    .delete-btn:hover { background: #fdecea; }
  </style>
</head>
<body>
  <a href="/listings" class="back-link">&larr; Back to listings</a>

  <div class="detail-thumb"><%= listing.category.charAt(0).toUpperCase() %></div>

  <div class="detail-top">
    <span class="detail-price">$<%= listing.price %></span>
    <span class="tag"><%= listing.category %></span>
  </div>

  <h1><%= listing.title %></h1>
  <div class="meta-row">
    <span>Posted <%= new Date(listing.createdAt).toLocaleDateString() %></span>
  </div>

  <p class="detail-description"><%= listing.description %></p>

  <div class="info-box">
    <strong>Pickup Location</strong>
    <%= listing.address %>
  </div>

  <form action="/listings/<%= listing.id %>/delete" method="POST"
        onsubmit="return confirm('Delete this listing?')">
    <button type="submit" class="delete-btn">Delete Listing</button>
  </form>
</body>
</html>