<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Market Place</title>
    <link rel="stylesheet" href="/css/index.css">
    <script type="module" src="/js/modal.js"></script>
</head>
<body>
    <main>
        <header class="page-header">
            <h1>Campus Marketplace</h1>
            <p class="subtitle">Buy and sell with students near you</p>
        </header>

        <div class="toolbar">
            <span class="count"><%= listings.length %> listing<%= listings.length !== 1 ? 's' : '' %></span>
            <button id="open-modal-btn">+ Add New Listing</button>
        </div>

        <div id="listing-modal" class="modal-overlay">
            <div class="modal-box">
                <button id="close-modal-btn" type="button">&times;</button>
                <form action="/listings" method="POST">
                    <label>
                         <span class="label-text">
                            Title<span style="color: red; margin-left: 2px;">*</span>
                        </span>
                        <input type="text" name="title" required>
                    </label>
                    <label>
                        Description
                        <textarea name="description"></textarea>
                    </label>
                    <label>
                        <span class="label-text">
                            Price ($)<span style="color: red; margin-left: 2px;">*</span>
                        </span>
                        <input type="number" name="price" min="0" step="0.01" required>
                    </label>
                    <label>
                        <span class="label-text">
                            Address / Pickup Location<span style="color: red; margin-left: 2px;">*</span>
                        </span>
                        <input type="text" name="address" required>
                    </label>
                    <label>
                         <span class="label-text">
                            Category<span style="color: red; margin-left: 2px;">*</span>
                        </span>
                        <select name="category" required>
                        <option value="books">Books</option>
                        <option value="furniture">Furniture</option>
                        <option value="electronics">Electronics</option>
                        <option value="other">Other</option>
                        </select>
                    </label>
                    <button type="submit">Submit</button>
                </form>
            </div>
        </div>

        <section class="listings-container">
            <% if (listings.length === 0) { %>
                <p>No listings yet. </p>
            <% } else { %>
                <% listings.forEach(l => { %>
                    <div class="listing-card">
                        <div class="listing-thumb"><%= l.category.charAt(0).toUpperCase() %></div>
                        <div class="listing-body">
                            <div class="listing-top">
                                <span class="price">$<%= l.price %></span>
                                <span class="tag"><%= l.category %></span>
                            </div>
                            <a class="title" href="/listings/<%= l.id %>"><%= l.title %></a>
                            <p class="description"><%= l.description %></p>
                            <span class="posted">Posted <%= new Date(l.createdAt).toLocaleDateString() %></span>
                            <form action="/listings/<%= l.id %>/delete" method="POST" class="delete-form" onsubmit="return confirm('Delete this listing?')">
                                <button type="submit" class="delete-btn">Delete</button>
                            </form>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </section>
        
    </main>
</body>
</html>